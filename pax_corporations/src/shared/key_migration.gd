static var renamed := 0   # how many keys/values the last migrate() renamed (the journal tells it)


## The state with the old keys renamed (a new Dictionary/Array; other values as they are).
static func migrate(v: Variant) -> Variant:
	if v is Dictionary:
		var out: Dictionary = {}
		for k: Variant in (v as Dictionary).keys():
			out[_name(k)] = migrate((v as Dictionary)[k])
		return out
	if v is Array:
		return (v as Array).map(func(x: Variant) -> Variant: return migrate(x))
	return _name(v)


static func _name(v: Variant) -> Variant:
	if v is String and OLD.has(v):
		renamed += 1
		return OLD[v]
	return v
